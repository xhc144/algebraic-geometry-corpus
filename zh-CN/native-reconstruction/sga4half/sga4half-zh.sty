% Chinese adaptation of this volume's original LNM 569 layout.
% Mathematical macros and counter hierarchy are inherited from sga-style.sty.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sga4half-zh}[2026/10/21 SGA 4half native Chinese edition]
\RequirePackage{sga-style}
\RequirePackage{fontspec}
\setmainfont{Latin Modern Roman}
\setsansfont{Latin Modern Sans}
\setmonofont{Latin Modern Mono}
\setCJKmainfont{Noto Serif CJK SC}[BoldFont=Noto Serif CJK SC Bold,ItalicFont=Noto Serif CJK SC]
\setCJKsansfont{Noto Sans CJK SC}[BoldFont=Noto Sans CJK SC Bold]
\setCJKmonofont{Noto Sans Mono CJK SC}
\geometry{paperwidth=461bp,paperheight=684bp,left=43bp,right=43bp,top=48bp,bottom=47bp,headheight=12pt,headsep=16pt,footskip=24pt}
\setlength{\emergencystretch}{1.5em}
\setlength{\parskip}{5pt plus 1pt}
\linespread{1.12}
\ctexset{chapter={name={},number={},format=\normalfont\centering\normalsize,beforeskip=12pt,afterskip=24pt},section={format=\normalfont\centering\normalsize,beforeskip=16pt,afterskip=12pt},subsection={format=\normalfont\normalsize,beforeskip=12pt,afterskip=6pt},subsubsection={format=\normalfont\normalsize,beforeskip=8pt,afterskip=4pt}}
\renewcommand{\contentsname}{目录}
\renewcommand{\bibname}{参考文献}
\renewcommand{\proofname}{证明}
\makeatletter
\@for\sgaenv:=proposition,corollary,definition,theorem,lemma,lemma_,corollary_,theorem_,proposition_,definition_,prop-def_\do{\expandafter\let\csname\sgaenv\endcsname\relax\expandafter\let\csname end\sgaenv\endcsname\relax}
\expandafter\let\csname theorem*\endcsname\relax
\expandafter\let\csname endtheorem*\endcsname\relax
\makeatother
\newtheorem{proposition}[subsubsection]{命题}
\newtheorem{corollary}[subsubsection]{推论}
\newtheorem{definition}[subsubsection]{定义}
\newtheorem{theorem}[subsubsection]{定理}
\newtheorem{lemma}[subsubsection]{引理}
\newtheorem{lemma_}[subsection]{引理}
\newtheorem{corollary_}[subsection]{推论}
\newtheorem{theorem_}[subsection]{定理}
\newtheorem{proposition_}[subsection]{命题}
\newtheorem{definition_}[subsection]{定义}
\newtheorem{prop-def_}[subsection]{命题--定义}
\newtheorem*{theorem*}{定理}
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small\nouppercase{\leftmark}}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}\renewcommand{\headrulewidth}{0pt}}
% The original chapter titles were centred, with no oversized chapter banner.
% Backreferences are part of the inherited native source dependency.
\renewcommand*{\backref}[1]{}
\renewcommand*{\backrefalt}[4]{\ifcase #1\or（引于第 #2 页）\else（引于第 #2 页）\fi}
